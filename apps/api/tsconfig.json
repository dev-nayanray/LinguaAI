{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // module/moduleResolution: "Node16" (not the deprecated "Node10"/
    // classic pairing, and not "CommonJS"+"Bundler" — TS rejects that
    // combination, TS5095) — Node16 still emits CommonJS output (matching
    // this package's own package.json, which has no "type": "module"),
    // while correctly understanding package.json "exports" subpaths like
    // @linguaai/observability/nestjs. Requires explicit .js extensions on
    // relative imports (see every *.ts file here) and a jest
    // moduleNameMapper to strip them back off for Jest's own resolver.
    "module": "Node16",
    "moduleResolution": "Node16",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

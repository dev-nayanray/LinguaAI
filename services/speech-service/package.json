    "@linguaai/validation": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "openai": "^7.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.13",
    "dotenv-cli": "^7.4.4",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",

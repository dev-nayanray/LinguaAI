# ==================================================
# LinguaAI — Environment Variables (example)
# Copy to .env and fill in real values. Never commit .env.
# ==================================================

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
# Same value as API_URL — apps/web and apps/admin (E2-T22) call the API
# directly from the browser, and only NEXT_PUBLIC_*-prefixed vars are
# available client-side (Next.js's own build-time inlining rule); API_URL
# itself stays server-only for every other consumer.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- services/* local ports (T16) ---
AI_ENGINE_URL=http://localhost:4001
# E11 T2 -- apps/api's own real, first consumer (SpeechServiceClientService,
# PronunciationModule); previously declared since E1 but never consumed by
# any application code.
SPEECH_SERVICE_URL=http://localhost:4002
RECOMMENDATION_ENGINE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004
ANALYTICS_SERVICE_URL=http://localhost:4005

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://linguaai:linguaai_dev_password@localhost:5432/linguaai
POSTGRES_USER=linguaai
POSTGRES_PASSWORD=linguaai_dev_password
POSTGRES_DB=linguaai
# app_role: RLS-subject, the standard per-request connection apps/api's
# AuthModule (and every later module) actually runs as (E2-T8) — never the
# migration-owning superuser above.
APP_DATABASE_URL=postgresql://app_role:app_role_dev_password@localhost:5432/linguaai
# app_service_role: BYPASSRLS, used only by registration/OAuth-creation,
# login's pre-auth credential lookup, the bootstrap-admin CLI, and the
# GDPR-erasure job (E2 design doc Part 9). Never the default per-request
# connection.
APP_SERVICE_ROLE_DATABASE_URL=postgresql://app_service_role:app_service_role_dev_password@localhost:5432/linguaai
# Gates packages/database's bootstrap-admin CLI (E2-T5, Part 9A) — an
# infra/deploy-tier secret, deliberately separate from application runtime
# secrets. Required only when running that script.
BOOTSTRAP_ADMIN_SECRET=

# --- Redis (cache, sessions, BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_SECRET=change_me_session_secret
# Field-level encryption for User.mfaSecret (E2-T13, SECURITY.md §4) — a
# 32-byte AES-256-GCM key, base64-encoded. Generate via `openssl rand
# -base64 32`; hold the real value in secrets management (DEPLOYMENT.md
# §7), never commit it.
MFA_SECRET_ENCRYPTION_KEY=
# Keys identity.login.failed's HMAC email hash (E2-T20, Part 10) — an
# unkeyed hash of a bounded, guessable input like an email is only
# marginally better than storing it raw. Rotatable, held in the same
# secrets-management path as the above (DEPLOYMENT.md §7). Generate via
# `openssl rand -base64 32`.
LOGIN_FAILURE_HMAC_KEY=
# Envelope encryption for AIMessage.content (E4 T5, ADR-029). "aws" in
# production (calls real AWS KMS via AI_MESSAGE_KMS_KEY_ID); "local-stub"
# in dev/CI, where AI_MESSAGE_LOCAL_STUB_MASTER_KEY stands in for KMS —
# same AES-256-GCM primitive as MFA_SECRET_ENCRYPTION_KEY above, generate
# with `openssl rand -base64 32`. getDataKeyProvider() throws if
# NODE_ENV=production and this isn't "aws".
AI_MESSAGE_KMS_PROVIDER=local-stub
AI_MESSAGE_KMS_KEY_ID=
AI_MESSAGE_LOCAL_STUB_MASTER_KEY=

# --- OAuth / Social Login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linguaai-media
S3_ACCESS_KEY_ID=linguaai
S3_SECRET_ACCESS_KEY=linguaai_dev_password
S3_FORCE_PATH_STYLE=true

# --- AI / LLM Providers (AI gateway abstracts these — see docs/AI_SYSTEM.md) ---
AI_GATEWAY_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_TEACHER_DEFAULT=claude-sonnet-5
AI_MODEL_ASSESSMENT_DEFAULT=claude-sonnet-5
# E8 T4 (ADR-041) — AI-assisted content drafting's own request class. Real,
# required config since E8 T4 shipped -- missing from this file until E10 T5
# found the drift (this section was never updated when ADR-041 landed).
AI_MODEL_CONTENT_DEFAULT=claude-sonnet-5
# E10 T5 (ADR-048) — session-end speaking-practice fluency scoring's own request class.
AI_MODEL_FLUENCY_DEFAULT=claude-sonnet-5
# E13 T1 (ADR-052) — RAG-grounded writing correction's own request class.
AI_MODEL_WRITING_DEFAULT=claude-sonnet-5
# Optional — ADR-034 cost circuit breaker's DEGRADE-stage target per request class.
# Falls back to the *_DEFAULT model above for a class with no economy model configured.
AI_MODEL_TEACHER_ECONOMY=
AI_MODEL_ASSESSMENT_ECONOMY=
AI_MODEL_CONTENT_ECONOMY=
AI_MODEL_FLUENCY_ECONOMY=
AI_MODEL_WRITING_ECONOMY=

# --- Vector database (pgvector by default; Pinecone optional for scale) ---
VECTOR_DB_PROVIDER=pgvector
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- Speech (STT / TTS) ---
# E10 T1 (ADR-043): both STT and TTS are pinned to OpenAI, reusing
# OPENAI_API_KEY above (services/ai-engine's own AI section) as its own
# independently-declared speechProviderEnvSchema fragment -- no separate
# credential needed. Replaces this section's own original E1 scaffolding
# (SPEECH_STT_PROVIDER/SPEECH_TTS_PROVIDER/ELEVENLABS_API_KEY/AZURE_SPEECH_*),
# which no code ever consumed and which named a materially different
# provider set than this epic's own real, researched decision.
# Shared HMAC secret (base64, `openssl rand -base64 32`) behind the
# short-lived internal token authorizing a client's direct WebSocket
# connection to speech-service -- apps/api signs it (E10 T2), speech-service
# verifies it locally (T1, zero network round-trip).
SPEECH_SESSION_TOKEN_SECRET=

# E11 T1 (ADR-049): pronunciation-scoring is a materially different
# capability from transcription/synthesis above -- whisper-1 (OpenAI) has
# no phoneme-level assessment mode. AZURE_SPEECH_KEY/AZURE_SPEECH_REGION
# were this section's own original E1 scaffolding, removed at E10 T1 as
# unconsumed dead config; E11 is their real, first-ever consumer.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- OCR / Translation Camera ---
OCR_PROVIDER=google-vision
GOOGLE_VISION_API_KEY=
TRANSLATION_PROVIDER=deepl
DEEPL_API_KEY=

# --- Payments / Billing ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@linguaai.app

# --- Push notifications ---
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info
# Apps run natively via `pnpm dev`, not inside the docker-compose network,
# so this points at otel-collector's host-mapped port, not its container
# hostname (docker-compose.yml, T11).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- docker-compose local host port overrides (all optional) ---
# Uncomment and change only if one of these default ports is already taken
# by something else on your machine (e.g. another project's docker-compose
# stack) — every service still listens on its standard port *inside* the
# docker network either way, only the host-side mapping changes.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# JAEGER_UI_PORT=16686
# OTEL_COLLECTOR_GRPC_PORT=4317
# OTEL_COLLECTOR_HTTP_PORT=4318

# --- Feature flags / experimentation ---
GROWTHBOOK_CLIENT_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

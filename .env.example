# ==================================================
# LinguaAI — Environment Variables (example)
# Copy to .env and fill in real values. Never commit .env.
# ==================================================

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://linguaai:linguaai_dev_password@localhost:5432/linguaai
POSTGRES_USER=linguaai
POSTGRES_PASSWORD=linguaai_dev_password
POSTGRES_DB=linguaai

# --- Redis (cache, sessions, BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_SECRET=change_me_session_secret

# --- OAuth / Social Login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linguaai-media
S3_ACCESS_KEY_ID=linguaai
S3_SECRET_ACCESS_KEY=linguaai_dev_password
S3_FORCE_PATH_STYLE=true

# --- AI / LLM Providers (AI gateway abstracts these — see docs/AI_SYSTEM.md) ---
AI_GATEWAY_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_TEACHER_DEFAULT=claude-sonnet-5
AI_MODEL_ASSESSMENT_DEFAULT=claude-sonnet-5

# --- Vector database (pgvector by default; Pinecone optional for scale) ---
VECTOR_DB_PROVIDER=pgvector
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- Speech (STT / TTS) ---
SPEECH_STT_PROVIDER=whisper
SPEECH_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- OCR / Translation Camera ---
OCR_PROVIDER=google-vision
GOOGLE_VISION_API_KEY=
TRANSLATION_PROVIDER=deepl
DEEPL_API_KEY=

# --- Payments / Billing ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@linguaai.app

# --- Push notifications ---
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Feature flags / experimentation ---
GROWTHBOOK_CLIENT_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

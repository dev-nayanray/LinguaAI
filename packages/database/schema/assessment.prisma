// E4 T3 — Assessment & learning plan domain (DATABASE.md §2.2, docs/epics/
// E4-database-schema-core-data-layer.md §5/§9).
//
// Not tenant-scoped (E4 §3.3, confirmed) — no RLS policy, no
// organizationId column on anything here.
//
// Cross-domain references (`userId` → identity.prisma's User, `languageId`
// → content.prisma's Language) are real Prisma `@relation` fields, with
// matching back-relation arrays on those models. An earlier version of
// this file used plain scalar columns + a manual migration-SQL FK instead,
// specifically to avoid coupling this file to identity.prisma/
// content.prisma — corrected in E4 T5 after discovering, against the real
// database, that the manual-FK approach doesn't survive even one further
// `prisma migrate dev` run from any domain (Prisma's diff engine has no
// record the constraint should exist and silently drops it as drift; this
// is exactly how T4's migration silently dropped nine of this file's own
// FKs). See identity.prisma's User model for the full explanation.

enum Skill {
  READING
  WRITING
  LISTENING
  SPEAKING
  VOCABULARY
  GRAMMAR
}

enum AssessmentType {
  PLACEMENT
  REASSESSMENT
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ProficiencySource {
  ASSESSMENT
  INFERRED
}

/// E6 T1 (ADR-037). MULTIPLE_CHOICE/FILL_IN_BLANK cover the 4 objective
/// skills (Reading/Listening/Vocabulary/Grammar) — deterministically
/// scored in apps/api against AssessmentItem.correctAnswer. OPEN_RESPONSE
/// is Writing-skill only — AssessmentItem.correctAnswer is null for these
/// (E6 design doc §6.1); scored by ai-engine (E6 T4), not an answer key.
enum AssessmentItemType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  OPEN_RESPONSE
}

model AssessmentAttempt {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  languageId String @db.Uuid

  type        AssessmentType
  status      AssessmentStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language  Language             @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responses AssessmentResponse[]

  @@index([userId, createdAt])
  @@index([languageId])
  @@map("AssessmentAttempt")
}

model AssessmentResponse {
  id        String   @id @default(uuid()) @db.Uuid
  attemptId String   @db.Uuid
  /// Nullable — E6 T1 (ADR-037) added AssessmentItem after this table already existed; a response created before an item bank existed has nothing to point to. Every response the adaptive algorithm (E6 T2) creates going forward sets this.
  itemId    String?  @db.Uuid
  skill     Skill
  prompt    String
  /// Structured, never raw HTML — validated at the application layer.
  response  Json
  isCorrect Boolean?
  score     Float?
  createdAt DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])
  item    AssessmentItem?   @relation(fields: [itemId], references: [id])

  @@index([attemptId])
  @@index([itemId])
  @@map("AssessmentResponse")
}

/// Curated placement-test item bank (E6 T1, ADR-037) — closes a real gap:
/// no reusable, standalone item bank existed anywhere in the schema before
/// this (AssessmentResponse.prompt was free text; content.prisma's
/// Exercise is bound to an authored curriculum Activity, structurally
/// incompatible with a pre-course placement test — confirmed by direct
/// inspection, E6 design doc §3.1). Mirrors KnowledgeBaseEntry's own
/// curated-content shape (versioned, linguist sign-off) rather than
/// Exercise's course-bound shape.
model AssessmentItem {
  id         String @id @default(uuid()) @db.Uuid
  languageId String @db.Uuid

  skill             Skill
  cefrLevel         CefrLevel
  /// Relative difficulty within its own (skill, cefrLevel) band — the adaptive algorithm's (E6 T2) own selection input, distinct from cefrLevel itself: two items can target the same CEFR band at different difficulty.
  difficulty        Float
  prompt            String
  /// Listening-skill items only — a real gap found while drafting T1's own
  /// seed content, not scoped in the E6 design doc's original §6.1 model
  /// (which only had `prompt: String`). Mirrors AIMessage.audioUrl's own
  /// existing precedent (ai.prisma) — real audio-file authoring/storage
  /// (S3, matching DATABASE.md's "Assessment/conversation raw audio: 90
  /// days" retention policy) is separately-scoped future content work, not
  /// this task's own seed pass; null here means the item's `prompt` field
  /// carries a text scaffold of what would be played, not real audio yet.
  audioUrl          String?
  /// Structured, never raw HTML — same discipline as Exercise.correctAnswer/AssessmentResponse.response. Null for OPEN_RESPONSE (Writing) items — scored by ai-engine (E6 T4), not an answer key.
  correctAnswer     Json?
  itemType          AssessmentItemType
  isActive          Boolean            @default(true)
  linguistSignOffBy String?
  linguistSignOffAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  language  Language             @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responses AssessmentResponse[]

  @@index([languageId, skill, cefrLevel, isActive])
  @@map("AssessmentItem")
}

/// Current CEFR level per user/language/skill — "current state" only; see
/// ProficiencyLevelHistory for the append-only trend record (DATABASE.md
/// §2.2's own stated reason this history table is required, not optional:
/// "did this user's fluency actually improve" is the named MVP success
/// metric, and current-state-only cannot answer it).
model ProficiencyLevel {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  languageId String @db.Uuid

  skill      Skill
  cefrLevel  CefrLevel
  confidence Float
  source     ProficiencySource
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language Language                  @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  history  ProficiencyLevelHistory[]

  @@unique([userId, languageId, skill])
  @@index([userId, languageId])
  @@map("ProficiencyLevel")
}

model ProficiencyLevelHistory {
  id                 String @id @default(uuid()) @db.Uuid
  proficiencyLevelId String @db.Uuid

  // Denormalized alongside proficiencyLevelId (not solely joined through
  // it) so a fluency-trend query never has to join through the mutable
  // ProficiencyLevel row — DATABASE.md §4's own (userId, languageId)
  // composite-index guidance, applied here.
  //
  // userId is nullable -- fixed in E4 T10 after discovering DATABASE.md
  // §6 explicitly names this table (alongside LearningEvent/AIUsageLog)
  // in the "append-only historical/event records... anonymized in place
  // (userId nulled/pseudonymized)" category, which requires a nullable
  // column to actually null on account erasure. Built NOT NULL here in
  // T3, matching this domain's other tables instead of this specific
  // stated policy; corrected via an ALTER COLUMN ... DROP NOT NULL in
  // T10's migration (safe, non-destructive).
  userId     String? @db.Uuid
  languageId String  @db.Uuid

  skill      Skill
  cefrLevel  CefrLevel
  confidence Float
  source     ProficiencySource
  recordedAt DateTime          @default(now())

  proficiencyLevel ProficiencyLevel @relation(fields: [proficiencyLevelId], references: [id])
  user             User?            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language         Language         @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, languageId, skill])
  @@index([proficiencyLevelId])
  @@map("ProficiencyLevelHistory")
}

model LearningPlan {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  languageId String @db.Uuid

  goal       String
  targetDate DateTime?
  /// Generated milestones — structured, produced by recommendation-engine (a later epic's own concern); this domain only stores the shape.
  milestones Json
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language   Language    @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dailyGoals DailyGoal[]

  @@index([userId, languageId])
  @@map("LearningPlan")
}

model DailyGoal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Optional — a daily goal can exist independent of any specific LearningPlan (a platform-wide default target).
  learningPlanId String? @db.Uuid

  date             DateTime @db.Date
  targetXp         Int
  targetMinutes    Int
  targetActivities Int
  completed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  learningPlan LearningPlan? @relation(fields: [learningPlanId], references: [id])

  @@unique([userId, date])
  @@map("DailyGoal")
}

# Copy to terraform.tfvars (git-ignored) for local runs, or supply these
# as -var/-var-file in CI (deploy-staging.yml, T23). Never commit real
# values — DEPLOYMENT.md §7.

aws_region = "us-east-1"
image_tag  = "replace-with-git-sha"

# Left empty until a real domain is provisioned for staging.
domain_name     = ""
route53_zone_id = ""

sentry_dsn_secret_arn = "arn:aws:secretsmanager:us-east-1:111111111111:secret:linguaai-staging-sentry-dsn-XXXXXX"

budget_alert_emails = ["devops@linguaai.example"]
